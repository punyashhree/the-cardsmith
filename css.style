<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
font-family:Georgia,serif;
background:linear-gradient(135deg,#667eea,#764ba2);
min-height:100vh;
padding:20px;
overflow-x:hidden
}

.login-container{
display:flex;
justify-content:center;
align-items:center;
min-height:100vh;
padding:20px
}
.login-box{
background:#fff;
border-radius:20px;
padding:50px 40px;
max-width:450px;
width:100%;
box-shadow:0 20px 60px rgba(0,0,0,.3);
text-align:center
}
.login-header{
margin-bottom:40px
}
.login-header h1{
color:#667eea;
font-size:36px;
margin-bottom:10px
}
.login-header p{
color:#666;
font-size:16px
}
.input-group{
text-align:left;
margin-bottom:20px
}
.input-group label{
display:block;
margin-bottom:8px;
color:#2d3748;
font-weight:bold;
font-size:14px
}
.input-group input{
width:100%;
padding:14px;
border:2px solid #ddd;
border-radius:8px;
font-size:16px;
font-family:Georgia,serif;
transition:border-color .3s
}
.input-group input:focus{
outline:none;
border-color:#667eea
}
.login-btn{
background:linear-gradient(135deg,#667eea,#764ba2);
color:#fff;
padding:16px;
border:none;
border-radius:8px;
font-size:18px;
font-weight:bold;
cursor:pointer;
margin-top:10px;
transition:.3s;
width:100%
}
.login-btn:hover{
transform:translateY(-2px);
box-shadow:0 8px 16px rgba(102,126,234,.4)
}

.app-container{
display:none
}
.app-container.active{
display:block
}
.container{
background:#fff;
border-radius:20px;
max-width:1100px;
width:100%;
margin:0 auto;
box-shadow:0 20px 60px rgba(0,0,0,.3);
overflow:hidden;
margin-bottom:20px
}
.header{
background:linear-gradient(135deg,#667eea,#764ba2);
color:#fff;
padding:25px;
text-align:center;
position:relative
}
.logout-btn{
position:absolute;
top:25px;
right:25px;
padding:8px 16px;
background:rgba(255,255,255,.2);
color:#fff;
border:2px solid #fff;
border-radius:6px;
cursor:pointer;
font-weight:bold;
transition:.3s
}
.logout-btn:hover{
background:rgba(255,255,255,.3)
}
.content{
display:flex;
flex-wrap:wrap
}
.form-section{
flex:1;
min-width:300px;
padding:30px;
background:#f8f9fa
}
.card-section{
flex:1;
min-width:300px;
padding:30px;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column
}
.form-group{margin-bottom:15px}
label{font-weight:bold;display:block;margin-bottom:5px}
input,textarea,select{
width:100%;
padding:10px;
margin-top:5px;
border:2px solid #ddd;
border-radius:6px;
font-family:Georgia,serif
}
input.error{
border-color:#e53e3e;
background:#fff5f5
}
.name-error{
color:#e53e3e;
font-size:12px;
margin-top:5px;
display:none
}
.name-error.show{
display:block
}
textarea{resize:vertical}
.button-group{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:10px
}
button,.file-label{
padding:12px 20px;
font-weight:bold;
cursor:pointer;
border:none;
border-radius:6px;
color:#fff;
transition:.3s;
display:inline-block;
text-align:center
}
button:hover,.file-label:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.2)}
.generate-btn{background:#4a5568;flex:1}
.preview-btn{background:#4a5568;flex:1}
.storage-btn{background:#4a5568;flex:1}
.feedback-btn{background:#ed8936;width:100%}
.purchase-btn{
background:linear-gradient(135deg,#f093fb,#f5576c);
width:100%;
font-size:18px;
padding:16px;
margin-top:10px
}
.purchase-btn:hover{
background:linear-gradient(135deg,#f5576c,#f093fb)
}
.card{
width:300px;
height:420px;
border-radius:18px;
padding:25px;
color:#333;
text-align:center;
display:flex;
flex-direction:column;
justify-content:center;
position:relative;
overflow:hidden;
box-shadow:0 12px 35px rgba(0,0,0,.3);
animation:cardFloat 5s ease-in-out infinite;
transition:background .5s ease
}
@keyframes cardFloat{
0%,100%{transform:translateY(0)}
50%{transform:translateY(-10px)}
}
.card h2{margin-bottom:15px;font-size:28px}
.card p{margin-bottom:12px;line-height:1.5}
.card-doodle{
position:absolute;
border:2px solid rgba(0,0,0,.15);
border-radius:50%;
animation:float 6s ease-in-out infinite
}
.cd1{width:60px;height:60px;top:-20px;left:-20px}
.cd2{width:40px;height:40px;top:20px;right:-15px;animation-delay:1s}
.cd3{width:50px;height:50px;bottom:-20px;right:-20px;animation-delay:2s}
.cd4{width:30px;height:30px;bottom:40px;left:-15px;animation-delay:3s}
.line{
position:absolute;
width:80px;
height:2px;
background:rgba(0,0,0,.15);
transform:rotate(45deg);
animation:pulse 4s ease-in-out infinite
}
.l1{top:50px;left:40px}
.l2{bottom:60px;right:30px;animation-delay:2s}
@keyframes float{
0%,100%{transform:translateY(0)}
50%{transform:translateY(-12px)}
}
@keyframes pulse{
0%,100%{opacity:.3}
50%{opacity:.7}
}
.price-section{
background:#fff;
border-radius:12px;
padding:20px;
margin-top:20px;
box-shadow:0 4px 12px rgba(0,0,0,.1);
width:100%;
max-width:300px
}
.price-header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:15px;
padding-bottom:10px;
border-bottom:2px solid #e2e8f0
}
.price-label{
font-size:14px;
color:#666;
font-weight:bold
}
.price-value{
font-size:24px;
color:#667eea;
font-weight:bold
}
.price-input-group{
display:flex;
align-items:center;
gap:10px;
margin-bottom:15px
}
.price-input{
flex:1;
padding:10px;
border:2px solid #ddd;
border-radius:6px;
font-size:16px;
font-weight:bold
}
.total-section{
background:#f7fafc;
padding:15px;
border-radius:8px;
margin-top:15px
}
.total-row{
display:flex;
justify-content:space-between;
margin-bottom:8px;
font-size:14px
}
.total-row.final{
font-size:18px;
font-weight:bold;
color:#2d3748;
padding-top:10px;
border-top:2px solid #cbd5e0
}
.feedback-section{
background:#f7fafc;
padding:30px;
border-top:3px solid #667eea;
display:none
}
.feedback-section.show{display:block}
.feedback-header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:20px;
flex-wrap:wrap;
gap:10px
}
.feedback-header h2{color:#2d3748;margin:0}
.close-btn{
padding:8px 16px;
background:#e53e3e;
color:#fff;
border:none;
border-radius:6px;
cursor:pointer;
font-weight:bold
}
.feedback-grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
gap:20px;
max-height:400px;
overflow-y:auto;
padding:10px
}
.feedback-card{
background:#fff;
padding:20px;
border-radius:12px;
box-shadow:0 4px 6px rgba(0,0,0,.1);
border-left:4px solid #667eea
}
.feedback-card-header{
display:flex;
align-items:center;
margin-bottom:10px
}
.feedback-avatar{
width:40px;
height:40px;
border-radius:50%;
background:linear-gradient(135deg,#667eea,#764ba2);
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-weight:bold;
margin-right:12px;
font-size:18px
}
.feedback-card h3{
margin:0;
color:#2d3748;
font-size:16px
}
.feedback-card p{
margin:0;
color:#4a5568;
line-height:1.6;
font-size:14px
}
.feedback-empty{
text-align:center;
padding:40px;
color:#a0aec0
}
.feedback-divider{
border-top:2px solid #ddd;
padding-top:15px;
margin-top:15px
}
.helper-text{
font-size:12px;
color:#666;
margin-top:8px;
font-style:italic
}
.modal{
display:none;
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,.7);
z-index:1000;
justify-content:center;
align-items:center;
animation:fadeIn .3s
}
.modal.show{display:flex}
@keyframes fadeIn{
from{opacity:0}
to{opacity:1}
}
.modal-content{
background:#fff;
border-radius:20px;
padding:40px;
max-width:500px;
width:90%;
box-shadow:0 20px 60px rgba(0,0,0,.3);
animation:slideUp .3s;
max-height:90vh;
overflow-y:auto
}
@keyframes slideUp{
from{transform:translateY(50px);opacity:0}
to{transform:translateY(0);opacity:1}
}
.modal-header{
text-align:center;
margin-bottom:25px
}
.modal-header h2{
color:#2d3748;
margin-bottom:10px
}
.success-icon{
font-size:60px;
margin-bottom:15px
}
.order-details{
background:#f7fafc;
padding:20px;
border-radius:12px;
margin:20px 0
}
.detail-row{
display:flex;
justify-content:space-between;
padding:10px 0;
border-bottom:1px solid #e2e8f0
}
.detail-row:last-child{border:none}
.detail-label{
color:#666;
font-weight:bold
}
.detail-value{
color:#2d3748;
font-weight:bold
}
.modal-buttons{
display:flex;
gap:10px;
margin-top:20px
}
.modal-btn{
flex:1;
padding:14px;
border:none;
border-radius:8px;
font-weight:bold;
cursor:pointer;
font-size:16px
}
.btn-primary{
background:#667eea;
color:#fff
}
.btn-secondary{
background:#e2e8f0;
color:#2d3748
}
.order-number{
font-size:24px;
color:#667eea;
font-weight:bold;
margin:10px 0
}
@media(max-width:768px){
.content{flex-direction:column}
.card{width:260px;height:380px}
.feedback-grid{grid-template-columns:1fr}
.price-section{max-width:100%}
.modal-content{padding:25px}
.login-box{padding:30px 25px}
.logout-btn{position:static;margin-bottom:15px}
}
</style>
